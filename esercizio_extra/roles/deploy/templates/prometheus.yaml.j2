global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["{{ elasticsearch_ip }}:{{ elasticsearch_ports[1] }}"]
        labels:
          vm: "elasticsearch-host"
      - targets: ["{{ grafana_ip }}:{{ grafana_ports[1] }}"]
        labels:
          vm: "monitoring-grafana"
      - targets: ["{{ prometheus_ip }}:{{ prometheus_ports[1] }}"]
        labels:
          vm: "monitoring-prometheus"
